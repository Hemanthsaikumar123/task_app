<h1>Edit Task</h1>

<%= form_with model: @task, local: true do |form| %>

  <p>
    <%= form.label :title %><br>
    <%= form.text_field :title %>
  </p>

  <p>
    <%= form.label :description %><br>
    <%= form.text_area :description %>
  </p>

  <%= form.submit "Update Task" %>

<% end %>
<%= link_to "Back", "/tasks" %>